VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Servidor únicamente (Vercel Edge Function en api/suggest-habits.ts) — SIN
# prefijo VITE_ a propósito, para que nunca llegue al bundle del cliente.
ANTHROPIC_API_KEY=

# Mercado Pago (api/checkout.ts, api/mp-webhook.ts, api/cancel-subscription.ts).
# MP_ACCESS_TOKEN: access token de producción de tu aplicación en
# https://www.mercadopago.com.ar/developers.
# MP_PRICE_*_ARS: el monto entero real en ARS que se cobra (sin puntos ni
# símbolo, ej. 3900) — nunca se hardcodea un precio en el código. Una
# suscripción CON preapproval_plan_id exige card_token_id tokenizado del
# lado del cliente, así que en vez de eso se crea "sin plan asociado" con
# `auto_recurring` inline, que sí soporta checkout hosteado pendiente.
# MP_WEBHOOK_SECRET: la "clave secreta" que configurás junto a la URL de
# notificaciones en el panel de MP, usada para validar la firma x-signature.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PRICE_MONTHLY_ARS=
MP_PRICE_YEARLY_ARS=

# Supabase Settings → API → service_role — para el webhook de MP y para
# api/send-notifications.ts (el cron de push, que necesita leer/escribir de
# todos los usuarios sin pasar por RLS). Nunca el mismo valor que la anon key,
# nunca en el bundle del cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Textos de precio mostrados en /premium — placeholders configurables sin
# tocar código. El monto real que se cobra vive en los MP_PRICE_*_ARS de
# arriba; esto es sólo lo que se muestra en pantalla, tienen que coincidir.
VITE_PREMIUM_MONTHLY_PRICE_LABEL=
VITE_PREMIUM_YEARLY_PRICE_LABEL=

# Web Push (notificaciones push reales, ver src/domain/push.ts, api/push-
# subscribe.ts, api/send-notifications.ts, src/sw.ts). Generar el par con
# `npx web-push generate-vapid-keys` (no requiere instalar nada global, ya
# está en dependencies). VITE_VAPID_PUBLIC_KEY es la MISMA clave pública, con
# prefijo VITE_ a propósito porque el navegador la necesita para suscribirse
# (una clave pública puede viajar al cliente sin problema). VAPID_SUBJECT es
# un mailto: o https:// de contacto, lo pide el estándar Web Push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@example.com
VITE_VAPID_PUBLIC_KEY=

# La usa Vercel Cron automáticamente: si está configurada, Vercel manda
# `Authorization: Bearer <CRON_SECRET>` en cada invocación programada (ver
# vercel.json → crons) y api/send-notifications.ts la valida — sin esto,
# cualquiera que descubra la URL del cron podría dispararlo. Generarla con
# cualquier string largo y aleatorio (ej. `openssl rand -hex 32`).
CRON_SECRET=
