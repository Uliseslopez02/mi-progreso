VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Servidor únicamente (Vercel Edge Function en api/suggest-habits.ts) — SIN
# prefijo VITE_ a propósito, para que nunca llegue al bundle del cliente.
ANTHROPIC_API_KEY=

# Mercado Pago (api/checkout.ts, api/mp-webhook.ts, api/cancel-subscription.ts).
# MP_ACCESS_TOKEN: access token de producción de tu aplicación en
# https://www.mercadopago.com.ar/developers.
# MP_PLAN_ID_*: ids de los preapproval_plan (con el monto real en ARS) creados
# una sola vez a mano — nunca se hardcodea un precio en el código.
# MP_WEBHOOK_SECRET: la "clave secreta" que configurás junto a la URL de
# notificaciones en el panel de MP, usada para validar la firma x-signature.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PLAN_ID_MONTHLY=
MP_PLAN_ID_YEARLY=

# Supabase Settings → API → service_role — SOLO para el webhook, que necesita
# escribir en `subscriptions` sin pasar por RLS. Nunca el mismo valor que la
# anon key, nunca en el bundle del cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Textos de precio mostrados en /premium — placeholders configurables sin
# tocar código. El monto real que se cobra vive en los MP_PLAN_ID_* de arriba;
# esto es sólo lo que se muestra en pantalla.
VITE_PREMIUM_MONTHLY_PRICE_LABEL=
VITE_PREMIUM_YEARLY_PRICE_LABEL=
